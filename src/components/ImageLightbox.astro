---
// 記事内の画像を押すと画面いっぱいに表示する（issue #46）。
// 対象は本文の画像（.prose img:not([class])）とヒーロー画像。リンクカードのサムネイルなど
// class 付きの画像には付けない（枠線と同じ範囲）。ライブラリは使わず、この 1 ファイルで完結させる。
// 押した画像だけを出し、前後の画像を送る機能は付けない。
---

<div id="image-lightbox" class="lightbox" hidden role="dialog" aria-modal="true" aria-label="画像の拡大表示">
	<img alt="" />
	<button type="button" class="close" aria-label="閉じる">×</button>
</div>

<style is:global>
	.prose img:not([class]),
	.hero-image img {
		cursor: zoom-in;
	}
	.lightbox {
		position: fixed;
		inset: 0;
		z-index: 1000;
		display: flex;
		align-items: center;
		justify-content: center;
		padding: 2rem;
		background: color-mix(in srgb, var(--ink-strong) 82%, transparent);
		cursor: zoom-out;
		/* スマホではピンチで寄れるようにする */
		touch-action: pinch-zoom;
		overflow: auto;
	}
	.lightbox[hidden] {
		display: none;
	}
	.lightbox img {
		max-width: 100%;
		max-height: calc(100vh - 4rem);
		object-fit: contain;
		background: var(--bg);
		border-radius: 6px;
		box-shadow: 0 8px 40px rgba(0, 0, 0, 0.4);
	}
	.lightbox .close {
		position: fixed;
		top: 1rem;
		right: 1rem;
		width: 2.6rem;
		height: 2.6rem;
		border: none;
		border-radius: 50%;
		background: rgba(255, 255, 255, 0.15);
		color: #fff;
		font-size: 1.5rem;
		line-height: 1;
		cursor: pointer;
	}
	.lightbox .close:hover {
		background: rgba(255, 255, 255, 0.3);
	}
	@media (max-width: 640px) {
		.lightbox {
			padding: 0.75rem;
		}
		.lightbox img {
			max-height: calc(100vh - 1.5rem);
		}
	}
</style>

<script>
	const box = document.getElementById('image-lightbox') as HTMLDivElement | null;
	const big = box?.querySelector('img') as HTMLImageElement | null;
	if (box && big) {
		// レイアウトの枠の中に置いたままだと position: fixed が枠に閉じ込められることがあるので body 直下に移す
		document.body.appendChild(box);
		const open = (src: string, alt: string) => {
			big.src = src;
			big.alt = alt;
			box.hidden = false;
			document.body.style.overflow = 'hidden';
		};
		const close = () => {
			box.hidden = true;
			big.removeAttribute('src');
			document.body.style.overflow = '';
		};
		document
			.querySelectorAll<HTMLImageElement>('.prose img:not([class]), .hero-image img')
			.forEach((img) => {
				img.addEventListener('click', () => open(img.currentSrc || img.src, img.alt));
			});
		box.addEventListener('click', close);
		document.addEventListener('keydown', (e) => {
			if (e.key === 'Escape' && !box.hidden) close();
		});
	}
</script>
