---
interface Props {
	id: string;
	title: string;
}

const { id, title } = Astro.props;
const playerUrl = `https://speakerdeck.com/player/${encodeURIComponent(id)}`;
---

<div class="speakerdeck-embed">
	<iframe
		src={playerUrl}
		title={`${title} | Speaker Deck`}
		loading="lazy"
		frameborder="0"
		allowfullscreen
	></iframe>
</div>
<p class="speakerdeck-source">
	<a href={playerUrl} target="_blank" rel="noopener noreferrer">Speaker Deckで開く</a>
</p>
